# Sunucuda .env olarak kopyalayip doldur. Bu dosya ve .env asla repoya girmez (yalniz .example).
# Sitenin alan adi, ornek: folyo.app
FOLYO_DOMAIN=

# Uretmek icin: openssl rand -base64 32
DB_PASSWORD=
# 32 bayt, base64. DEGISTIRILIRSE kayitli Spotify/Strava baglantilari cozulemez.
FOLYO_TOKEN_KEY=

# Yonetici e-postalari (virgulle). Bu e-postayi dogrulayan hesap /admin panelinden SMS ve e-posta
# entegrasyonlarini ve dogrulama kurallarini secer.
FOLYO_ADMIN_EMAILS=

# Giris saglayicilari (en az biri; dev girisi prod'da yoktur)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opsiyonel canli kartlar ve bildirim
FOLYO_GITHUB_TOKEN=
FOLYO_LASTFM_API_KEY=
FOLYO_REDDIT_CLIENT_ID=
FOLYO_REDDIT_CLIENT_SECRET=
FOLYO_SPOTIFY_CLIENT_ID=
FOLYO_SPOTIFY_CLIENT_SECRET=
FOLYO_STRAVA_CLIENT_ID=
FOLYO_STRAVA_CLIENT_SECRET=
FOLYO_EXPO_ACCESS_TOKEN=

# Belirli bir surumu calistirmak icin (varsayilan: latest)
# API_IMAGE=ghcr.io/yavuzsayinbulut/folyo-api:<git-sha>
# WEB_IMAGE=ghcr.io/yavuzsayinbulut/folyo-web:<git-sha>
