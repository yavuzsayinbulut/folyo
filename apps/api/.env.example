# Yerel gelistirme icin: cp .env.example .env, degerleri doldur, sonra
#   set -a; . ./.env; set +a; ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
# .env asla Git'e girmez.

# Zorunlu. Spotify/Strava token'larini sifreleyen 32 baytlik anahtar: openssl rand -base64 32
FOLYO_TOKEN_KEY=

# Google/GitHub ile giris (bos birakilan saglayici kapali kalir; dev profilinde isimle gelistirici girisi var)
FOLYO_LOGIN_GOOGLE_CLIENT_ID=
FOLYO_LOGIN_GOOGLE_CLIENT_SECRET=
FOLYO_LOGIN_GITHUB_CLIENT_ID=
FOLYO_LOGIN_GITHUB_CLIENT_SECRET=

# Opsiyonel canli kartlar ve bildirim
FOLYO_GITHUB_TOKEN=
FOLYO_LASTFM_API_KEY=
FOLYO_REDDIT_CLIENT_ID=
FOLYO_REDDIT_CLIENT_SECRET=
FOLYO_SPOTIFY_CLIENT_ID=
FOLYO_SPOTIFY_CLIENT_SECRET=
FOLYO_STRAVA_CLIENT_ID=
FOLYO_STRAVA_CLIENT_SECRET=
FOLYO_EXPO_ACCESS_TOKEN=
