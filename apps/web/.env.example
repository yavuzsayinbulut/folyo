# Bos birakilan degerler yerel varsayilanlari kullanir (API: http://localhost:8080, site: http://localhost:3100).
# .env* dosyalari Git'e girmez; yalniz bu ornek dosya girer.

# Spring API adresi. Next.js rewrite hedefi derleme aninda sabitlenir (Docker'da build argumani).
API_URL=
# Sitenin herkese acik adresi (meta etiketleri ve paylasim gorselleri icin).
WEB_URL=
# Topluluk kurallari sayfasinda gosterilen destek e-postasi (App Store kullanici icerigi kurali iletisim bilgisi ister).
NEXT_PUBLIC_SUPPORT_EMAIL=
