{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8080",
        "EXPO_PUBLIC_WEB_URL": "http://localhost:3100"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://folyo.app",
        "EXPO_PUBLIC_WEB_URL": "https://folyo.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://folyo.app",
        "EXPO_PUBLIC_WEB_URL": "https://folyo.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
